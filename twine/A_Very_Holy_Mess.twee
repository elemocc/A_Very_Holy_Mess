:: Check_challenge1 {"position":"2175,75","size":"100,100"}
(if: $choose is $target)[
   '' Correct, you have identified the right figure''

    (if: $choose is "Saint Peter")[<img src="img/S. Pietro.png">]
    (else-if: $choose is "Archangel Gabriel")[ <img src="img/S Gabriele.png"> ]
    (else-if: $choose is "Holy Mary")[<img src="img/Madonna.png"> ]
    (else-if: $choose is "Saint Paul")[<img src="img/S. Paolo.png">  ]
    (else-if: $choose is "Archangel Michael")[<img src="img/San Michele.jpg">]

    (set: $corrette to it + 1)

    (if: $corrette is 5)[
        ''Excellent, you have completed the challenge!''
        [[Proceed -> Instructions Michele]]
    ]
    (else:)[
        [[Proceed ->Challenge_1]]
    ]
]
(else:)[
   '' Wrong! The figure doesn't match. Start over''
    (set: $corrette to 0)
    [[''Try again'' ->Challenge_1]]
]


