:: StoryStylesheet [stylesheet]

:root {
  --bg-dark: #241207;
  --bg-mid: #4a250d;
  --gold: #d6a84a;
  --gold-soft: #f2d184;
  --text-main: #f4e2bd;
  --text-muted: #c7a978;
  --red-dark: #5a1710;

  --font-title: "MedievalSharp", "Cinzel Decorative", Georgia, serif;
  --font-body: Georgia, "Cormorant Garamond", serif;
}

/* General background */
html,
body,
tw-story {
  margin: 0;
  min-height: 100%;
  background:
    radial-gradient(circle at top, rgba(214, 168, 74, 0.18), transparent 35%),
    linear-gradient(180deg, var(--bg-mid) 0%, var(--bg-dark) 70%, #100703 100%);
  color: var(--text-main);
  font-family: var(--font-body);
}

/* Main page area */
tw-passage {
  max-width: 60vw;
  min-height: 100vh;
  margin: 0 auto;
  padding: 42px 28px;
  box-sizing: border-box;
  background:
    linear-gradient(rgba(35, 16, 6, 0.82), rgba(20, 8, 3, 0.92)),
    radial-gradient(circle at center, rgba(214, 168, 74, 0.10), transparent 70%);

  /*border-left: 1px solid rgba(214, 168, 74, 0.35);
  border-right: 1px solid rgba(214, 168, 74, 0.35);
  box-shadow: 0 0 32px rgba(0, 0, 0, 0.65);*/
}

/* Very subtle inner frame 

}

/* Titles */
h1,
h2,
h3 {
  font-family: var(--font-title);
  color: var(--gold-soft);
  text-align: center;
  font-weight: normal;
  text-shadow: 0 3px 6px rgba(0, 0, 0, 0.8);
}

h1 {
  font-size: 2.4rem;
  margin: 32px 0 20px;
}

h2 {
  font-size: 1.7rem;
  margin: 26px 0 14px;
}

/* Text */
p {
  font-size: 1.12rem;
  line-height: 1.45;
  color: var(--text-main);
  text-align: justify;
}

em,
.subtitle {
  color: var(--text-muted);
}

/* Twine links, kept simple */
tw-link,
.enchantment-link {
  color: var(--gold-soft);
  font-family: var(--font-title);
  text-decoration: none;
  border-bottom: 1px solid rgba(214, 168, 74, 0.5);
}

tw-link:hover,
.enchantment-link:hover {
  color: #fff1bd;
  text-shadow: 0 0 8px rgba(214, 168, 74, 0.7);
}

/* Optional divider */
hr {
  border: none;
  height: 1px;
  margin: 24px auto;
  width: 70%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(214, 168, 74, 0.7),
    transparent
  );
}

tw-passage {
  border: none !important;
}

img {
	height: 530px;
    width: auto; 
    display: block;
    margin-left: auto;
    margin-right: auto;
}

video {
	display: block;
    margin-left: auto;
    margin-right: auto;
}